# Required
BETTER_AUTH_SECRET=change-me-to-a-long-random-string   # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database: local file for development, a Turso/libSQL URL in production
DATABASE_URL=file:./data/local.db
# DATABASE_AUTH_TOKEN=

# Optional: enables the "Continue with Google" button
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: comma-separated emails of admins who can delete any community message
# ADMIN_EMAILS=you@example.com

# Production only: other addresses the site is reached on, comma separated (for example the www version)
# TRUSTED_ORIGINS=https://www.example.com

# Optional but polite: a website or email that the free OpenStreetMap and Open Food Facts servers can use to contact you if your app misbehaves
# CONTACT_URL=https://your-site.example

# Gym finder: one or several Overpass servers, comma separated (default: three public mirrors)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
