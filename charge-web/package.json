{
  "name": "charge",
  "version": "1.0.0",
  "description": "Charge: workout tracker with onboarding, AI-style routine assistant and Strong-style logging",
  "author": "zeon.studio",
  "license": "MIT",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "concurrently \"node scripts/themeGenerator.mjs --watch\" \"next dev\"",
    "build": "node scripts/themeGenerator.mjs && next build",
    "preview": "next start",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier -w ./src",
    "generate-json": "node scripts/jsonGenerator.mjs",
    "generate-llms": "node scripts/llmsGenerator.mjs",
    "remove-darkmode": "node scripts/removeDarkmode.mjs && pnpm format",
    "db:push:prod": "node --env-file=.env.production scripts/db-setup.mjs",
    "db:push": "node scripts/db-setup.mjs",
    "start": "next start",
    "db:push:kit": "drizzle-kit push"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@libsql/client": "^0.18.0",
    "@next/third-parties": "16.1.6",
    "@types/leaflet": "^1.9.22",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "better-auth": "^1.7.12",
    "date-fns": "^4.1.0",
    "disqus-react": "^1.1.7",
    "drizzle-orm": "^0.45.4",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "marked": "^17.0.3",
    "motion": "^14.6.0",
    "next": "16.1.6",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-gtm-module": "^2.0.11",
    "react-icons": "^5.5.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swiper": "^12.1.2",
    "three": "^0.170.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.170.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.0.2",
    "eslint-config-next": "16.1.6",
    "glob": "^13.0.6",
    "node-html-parser": "^7.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "0.34.5",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.2.1",
    "turndown": "^7.2.4",
    "typescript": "5.9.3"
  },
